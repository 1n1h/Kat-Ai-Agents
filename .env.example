# ── Required for chat ────────────────────────────────────────────────
# Anthropic API key — powers all agents via the Claude Agent SDK
ANTHROPIC_API_KEY=

# Optional: override the orchestrator model (defaults to claude-opus-4-8)
# ANTHROPIC_MODEL=

# ── Auth (Firebase / Google) — app runs in local mode until these are set
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Legal & government research tools (free) ────────────────────────
# One api.data.gov key covers Regulations.gov, GovInfo, AND Congress.gov.
# Get it free at https://api.data.gov/signup/
DATA_GOV_API_KEY=
# CourtListener case-law search — free token from a CourtListener account:
# https://www.courtlistener.com/help/api/ (Profile → API tokens)
COURTLISTENER_API_TOKEN=

# ── Later phases (placeholders from the project doc) ─────────────────
# ELEVENLABS_API_KEY=          # TTS / STT (dictation)
# TOGETHER_API_KEY=            # optional vision/OCR cost tier
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
