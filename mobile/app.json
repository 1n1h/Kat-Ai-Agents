{
  "expo": {
    "name": "Lex & Co.",
    "slug": "lex-co",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lexandco.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Lex uses the camera to scan documents and read them into a matter.",
        "NSPhotoLibraryUsageDescription": "Lex reads documents and images you choose so it can transcribe and analyze them."
      }
    },
    "android": {
      "package": "com.lexandco.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1B26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EC",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lex reads documents and images you choose so it can transcribe and analyze them.",
          "cameraPermission": "Lex uses the camera to scan documents and read them into a matter."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBase": "https://kat-ai-agents.vercel.app",
      "router": {},
      "eas": {
        "projectId": "fea3a983-09b6-4de4-9d34-34e9c2015313"
      }
    }
  }
}
